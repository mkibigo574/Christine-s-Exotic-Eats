# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://mxaezkfyowvotzfrnfil.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_muANVRVXTQqaLq4vYVd9sw_DGoWhCIu
# Service-role key (Project Settings → API → service_role). Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (for inquiry replies). Get from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender — must be a domain you've verified with Resend, e.g. enquiries@christines-exoticeats.com.au
RESEND_FROM="Christine's Exotic Eats <enquiries@christines-exoticeats.com.au>"
# Optional: BCC every reply to Christine so she has a copy in her inbox
RESEND_BCC=

# Cloudflare Turnstile (spam protection on the enquiry form).
# Create a free widget at https://dash.cloudflare.com -> Turnstile.
# Site key is public (shipped to the browser); secret key is server-only.
# If both are left blank, the widget is hidden and server verification is
# skipped -- handy for local dev, but set them in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
